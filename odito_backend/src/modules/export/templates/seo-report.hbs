      margin-bottom: 5px;
    }
    .header .project-url {
      font-size: 12px;
      color: #64748b;
      word-break: break-all;
    }
    .header .meta {
      margin-top: 15px;
      font-size: 10px;
      color: #94a3b8;
    }
    .section {
      margin-bottom: 25px;
      page-break-inside: avoid;
    }
    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: #1e40af;
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid #e2e8f0;
    }
    .overview-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .metric-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 12px;
      text-align: center;
    }
    .metric-card .value {
      font-size: 20px;
      font-weight: 700;
      color: #1e40af;
    }
    .metric-card .label {
      font-size: 9px;
      color: #64748b;
      text-transform: uppercase;
      margin-top: 4px;
    }
    .metric-card.high .value { color: #dc2626; }
    .metric-card.medium .value { color: #f59e0b; }
    .metric-card.low .value { color: #22c55e; }
    .scores-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .score-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 15px;
    }
    .score-card .main-score {
      font-size: 36px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 10px;
    }
    .score-card .main-score.excellent { color: #16a34a; }
    .score-card .main-score.good { color: #22c55e; }
    .score-card .main-score.average { color: #eab308; }
    .score-card .main-score.poor { color: #f97316; }
    .score-card .main-score.critical { color: #dc2626; }
    .score-card .grade {
      font-size: 48px;
      font-weight: 700;
      text-align: center;
      color: #1e40af;
    }
    .distribution-bar {
      display: flex;
      height: 20px;
      border-radius: 4px;
      overflow: hidden;
      margin-top: 10px;
    }
    .distribution-bar .excellent { background: #16a34a; }
    .distribution-bar .good { background: #22c55e; }
    .distribution-bar .average { background: #eab308; }
    .distribution-bar .poor { background: #f97316; }
    .distribution-bar .critical { background: #dc2626; }
    .distribution-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 8px;
      font-size: 8px;
    }
    .distribution-legend span {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .distribution-legend .dot {
      width: 8px;
      height: 8px;
      border-radius: 2px;
    }
    .issues-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }
    .issues-table th {
      background: #f1f5f9;
      padding: 8px 6px;
      text-align: left;
      font-weight: 600;
      color: #475569;
      border-bottom: 1px solid #e2e8f0;
    }
    .issues-table td {
      padding: 6px;
      border-bottom: 1px solid #f1f5f9;
    }
    .issues-table tr:hover {
      background: #f8fafc;
    }
    .severity-badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 8px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .severity-badge.high { background: #fef2f2; color: #dc2626; }
    .severity-badge.medium { background: #fffbeb; color: #f59e0b; }
