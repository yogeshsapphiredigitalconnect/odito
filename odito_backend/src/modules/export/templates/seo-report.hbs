      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }
    .pages-table th {
      background: #f1f5f9;
      padding: 8px 6px;
      text-align: left;
      font-weight: 600;
      color: #475569;
      border-bottom: 1px solid #e2e8f0;
    }
    .pages-table td {
      padding: 6px;
      border-bottom: 1px solid #f1f5f9;
      word-break: break-all;
    }
    .pages-table tr:hover {
      background: #f8fafc;
    }
    .performance-section {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }
    .perf-metric {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 10px;
      text-align: center;
    }
    .perf-metric .value {
      font-size: 16px;
      font-weight: 700;
      color: #1e40af;
    }
    .perf-metric .label {
      font-size: 8px;
      color: #64748b;
      margin-top: 2px;
    }
    .perf-metric .unit {
      font-size: 9px;
      color: #94a3b8;
    }
    .category-section {
      margin-bottom: 15px;
    }
    .category-title {
      font-size: 11px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 8px;
    }
    .category-counts {
      display: flex;
      gap: 8px;
      font-size: 9px;
    }
    .category-counts .count {
      padding: 2px 6px;
      border-radius: 3px;
      background: #f1f5f9;
    }
    .category-counts .count.high { background: #fef2f2; }
    .category-counts .count.medium { background: #fffbeb; }
    .category-counts .count.low { background: #f0fdf4; }
    .footer {
      margin-top: 30px;
      padding-top: 15px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      font-size: 9px;
      color: #94a3b8;
    }
    .no-data {
      text-align: center;
      padding: 20px;
      color: #94a3b8;
      font-style: italic;
    }
    .page-break {
      page-break-before: always;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>SEO Audit Report</h1>
    <div class="project-name">{{project.project_name}}</div>
    <div class="project-url">{{project.main_url}}</div>
    <div class="meta">
      Generated: {{formatDate generatedAt}} | Pages: {{overview.totalPages}} | Issues: {{overview.totalIssues}}
    </div>
  </div>

  <div class="section">
    <div class="section-title">Overview</div>
    <div class="overview-grid">
      <div class="metric-card">
        <div class="value">{{overview.totalPages}}</div>
        <div class="label">Total Pages</div>
      </div>
      <div class="metric-card">
        <div class="value">{{overview.totalPages}}</div>
        <div class="label">Crawled</div>
      </div>
      <div class="metric-card">
        <div class="value">{{overview.totalIssues}}</div>
        <div class="label">Total Issues</div>
      </div>
      <div class="metric-card high">
        <div class="value">{{overview.highIssues}}</div>
        <div class="label">High Priority</div>
      </div>
      <div class="metric-card medium">
        <div class="value">{{overview.mediumIssues}}</div>
        <div class="label">Medium Priority</div>
      </div>
      <div class="metric-card low">
        <div class="value">{{overview.lowIssues}}</div>
        <div class="label">Low Priority</div>
      </div>
    </div>
  </div>

  {{#if scores.websiteScore}}
  <div class="section">
    <div class="section-title">Website Score</div>
    <div class="scores-section">
      <div class="score-card">
        <div class="main-score {{#if (gte scores.websiteScore 90)}}excellent{{else if (gte scores.websiteScore 75)}}good{{else if (gte scores.websiteScore 60)}}average{{else if (gte scores.websiteScore 40)}}poor{{else}}critical{{/if}}">
          {{scores.websiteScore}}
        </div>
        <div class="label">Overall Score</div>
        <div class="distribution-legend">
          <span><div class="dot" style="background:#16a34a"></div> 90+ Excellent</span>
          <span><div class="dot" style="background:#22c55e"></div> 75-89 Good</span>
          <span><div class="dot" style="background:#eab308"></div> 60-74 Average</span>
          <span><div class="dot" style="background:#f97316"></div> 40-59 Poor</span>
          <span><div class="dot" style="background:#dc2626"></div> <40 Critical</span>
        </div>
      </div>
      <div class="score-card">
        <div class="grade">{{scores.websiteGrade}}</div>
        <div class="label">Grade</div>
        <div style="margin-top:15px">
          <div class="distribution-bar">
            <div class="excellent" style="width:{{scores.scoreDistribution.excellent}}%"></div>
            <div class="good" style="width:{{scores.scoreDistribution.good}}%"></div>
            <div class="average" style="width:{{scores.scoreDistribution.average}}%"></div>
            <div class="poor" style="width:{{scores.scoreDistribution.poor}}%"></div>
            <div class="critical" style="width:{{scores.scoreDistribution.critical}}%"></div>
          </div>
          <div class="distribution-legend">
            <span>Excellent: {{scores.scoreCounts.excellent}}</span>
            <span>Good: {{scores.scoreCounts.good}}</span>
            <span>Average: {{scores.scoreCounts.average}}</span>
            <span>Poor: {{scores.scoreCounts.poor}}</span>
            <span>Critical: {{scores.scoreCounts.critical}}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  {{#if issues.byCategory.length}}
  <div class="section">
    <div class="section-title">Issues by Category</div>
    {{#each issues.byCategory}}
    <div class="category-section">
      <div class="category-title">{{this.category}}</div>
      <div class="category-counts">
        <span class="count">Total: {{this.count}}</span>
        {{#if this.highCount}}<span class="count high">High: {{this.highCount}}</span>{{/if}}
        {{#if this.mediumCount}}<span class="count medium">Medium: {{this.mediumCount}}</span>{{/if}}
        {{#if this.lowCount}}<span class="count low">Low: {{this.lowCount}}</span>{{/if}}
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if issues.bySeverity.length}}
  <div class="section">
    <div class="section-title">Top Issues by Severity</div>
    <table class="issues-table">
      <thead>
        <tr>
          <th style="width:15%">Severity</th>
          <th style="width:10%">Count</th>
          <th style="width:20%">Issue Code</th>
          <th style="width:35%">Message</th>
          <th style="width:20%">Page</th>
        </tr>
      </thead>
      <tbody>
        {{#each issues.bySeverity}}
        {{#each this.topIssues}}
        <tr>
          <td><span class="severity-badge {{this ../severity}}">{{this ../severity}}</span></td>
          <td>{{this.count}}</td>
          <td>{{this.code}}</td>
          <td>{{truncate this.message 60}}</td>
          <td>{{truncate this.pageUrl 40}}</td>
        </tr>
        {{/each}}
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <div class="footer">
    <p>Report generated by Odito SEO Platform | {{formatDate generatedAt}}</p>
    <p>{{project.main_url}}</p>
  </div>
</body>
</html>
