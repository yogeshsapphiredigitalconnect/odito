# ======================================
# ODITO BACKEND - PRODUCTION ENVIRONMENT
# ======================================
# CRITICAL: All variables are REQUIRED - No fallbacks allowed
# CRITICAL: Copy this file to .env and fill in actual values

# ======================================
# 🌐 SERVICE URLs (REQUIRED)
# ======================================
# Backend URLs - Internal and external access
BACKEND_URL=https://api.oditoai.com
BACKEND_INTERNAL_URL=https://api.oditoai.com
BACKEND_PUBLIC_URL=https://api.oditoai.com
MEDIA_BASE_URL=https://api.oditoai.com

# Frontend URL - CORS configuration
CORS_ORIGIN=https://oditoai.com

# Python Worker URLs
PYTHON_WORKER_URL=https://python.oditoai.com
PYTHON_WORKER_INTERNAL_URL=https://python.oditoai.com

# Video Worker URLs
VIDEO_WORKER_URL=https://video.oditoai.com
VIDEO_WORKER_INTERNAL_URL=https://video.oditoai.com

# ======================================
# 🖥️ SERVER CONFIGURATION (REQUIRED)
# ======================================
# Server port
PORT=5000

# Environment
NODE_ENV=production

# ======================================
# 🗄️ DATABASE (REQUIRED)
# ======================================
# MongoDB connection string
MONGO_URI=<YOUR_MONGO_URI>

# ======================================
# 🔐 SECURITY (REQUIRED)
# ======================================
# JWT secret - Use a strong, random string
JWT_SECRET=<YOUR_JWT_SECRET>

# JWT expiry
JWT_EXPIRY=7d

# Worker Authentication Token
SYSTEM_WORKER_TOKEN=<YOUR_SYSTEM_WORKER_TOKEN>

# ======================================
# 🤖 AI SERVICES (REQUIRED)
# ======================================
# Groq API (Primary AI Provider)
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Google Gemini API (Fallback AI Provider)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.0-flash

# ======================================
# 📧 EMAIL CONFIGURATION (REQUIRED)
# ======================================
# SendGrid Configuration
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
EMAIL_FROM_ADDRESS=noreply@odito.com
EMAIL_FROM_NAME=Odito Team

# Gmail Configuration (for admin alerts)
GMAIL_USER=<YOUR_GMAIL_USER>
GMAIL_APP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>

# ======================================
# 🔐 AUTHENTICATION (REQUIRED)
# ======================================
# Google OAuth Configuration
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_OAUTH_REDIRECT=https://api.oditoai.com/auth/oauth/google/callback

# ======================================
# 💳 PAYMENT CONFIGURATION (REQUIRED)
# ======================================
# Stripe Configuration
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_PREMIUM_MONTHLY=<YOUR_STRIPE_PRICE_PREMIUM_MONTHLY>
STRIPE_PRICE_PREMIUM_YEARLY=<YOUR_STRIPE_PRICE_PREMIUM_YEARLY>
STRIPE_PRICE_ENTERPRISE_MONTHLY=<YOUR_STRIPE_PRICE_ENTERPRISE_MONTHLY>
STRIPE_PRICE_ENTERPRISE_YEARLY=<YOUR_STRIPE_PRICE_ENTERPRISE_YEARLY>

# ======================================
# 📊 EXTERNAL APIS (REQUIRED)
# ======================================
# Google PageSpeed Insights API
PSI_API_KEY=<YOUR_PSI_API_KEY>

# Google Places API
GOOGLE_PLACES_API_KEY=<YOUR_GOOGLE_PLACES_API_KEY>

# DataForSEO API Credentials
DATAFORSEO_LOGIN=<YOUR_DATAFORSEO_LOGIN>
DATAFORSEO_PASSWORD=<YOUR_DATAFORSEO_PASSWORD>

# ======================================
# 🔔 ADMIN ALERTS (OPTIONAL)
# ======================================
# Admin Email Configuration
ADMIN_EMAIL_USER=<YOUR_ADMIN_EMAIL_USER>
ADMIN_EMAIL_PASS=<YOUR_ADMIN_EMAIL_PASS>
ADMIN_EMAIL_FROM=alerts@oditoai.com
ADMIN_ALERT_EMAIL=admin-team@oditoai.com

# Slack Webhook URL
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# ======================================
# 📱 OTP CONFIGURATION (REQUIRED)
# ======================================
# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESEND_PER_HOUR=3

# ======================================
# 🎙️ VOICE SERVICES (OPTIONAL)
# ======================================
# ElevenLabs API Key for voice generation
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_API_KEY>

# OpenAI API Key for TTS fallback
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# ElevenLabs Voice ID
ELEVENLABS_VOICE_ID=rachel

# ======================================
# 📊 MONITORING (OPTIONAL)
# ======================================
# Log level
LOG_LEVEL=info

# ======================================
# 📁 FILE STORAGE (OPTIONAL)
# ======================================
# Public path for static files
BACKEND_PUBLIC_PATH=/path/to/your/public/files

# ======================================
# 🎥 VIDEO CONFIGURATION (OPTIONAL)
# ======================================
# Video output directory
VIDEO_OUTPUT_DIR=/path/to/video/output

# Audio cache directory
AUDIO_CACHE_DIR=/path/to/audio/cache

# ======================================
# 🐛 DEBUG CONFIGURATION (OPTIONAL)
# ======================================
# AI Video Debug Mode
AI_VIDEO_DEBUG=false

