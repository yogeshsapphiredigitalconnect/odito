# ======================================
# ODITO PYTHON WORKERS - PRODUCTION ENVIRONMENT
# ======================================
# CRITICAL: All variables are REQUIRED - No fallbacks allowed
# CRITICAL: Copy this file to .env and fill in actual values

# ======================================
# 🌐 SERVICE URLs (REQUIRED)
# ======================================
# Backend URL - Main backend service (consistent across all services)
BACKEND_URL=https://api.oditoai.com

# Python Worker URL - This service's own URL
PYTHON_WORKER_URL=https://python.oditoai.com

# ======================================
# 🗄️ DATABASE (REQUIRED)
# ======================================
# MongoDB connection string (use same as backend)
MONGODB_URI=<YOUR_MONGO_URI>

# ======================================
# 📊 EXTERNAL APIS (REQUIRED)
# ======================================
# Google PageSpeed Insights API
PSI_API_KEY=<YOUR_PSI_API_KEY>

# DataForSEO API Credentials (for Keyword Research)
DATAFORSEO_LOGIN=<YOUR_DATAFORSEO_LOGIN>
DATAFORSEO_PASSWORD=<YOUR_DATAFORSEO_PASSWORD>

# ======================================
# 🤖 AI SERVICES (OPTIONAL but RECOMMENDED)
# ======================================
# Google Gemini API Key for AI features
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# OpenAI API Key for TTS and AI features
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# ======================================
# 🎙️ VOICE SERVICES (OPTIONAL)
# ======================================
# ElevenLabs API Key for voice generation
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_API_KEY>

# ElevenLabs Voice ID
ELEVENLABS_VOICE_ID=rachel

# ======================================
# 📊 MONITORING (OPTIONAL)
# ======================================
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Worker timeout in milliseconds
WORKER_TIMEOUT=300000

# Maximum retry attempts
MAX_RETRIES=3

# ======================================
# 🚀 PERFORMANCE (OPTIONAL)
# ======================================
# Concurrent job limit
MAX_CONCURRENT_JOBS=5

# Rate limit delay between requests
RATE_LIMIT_DELAY=1000

# ======================================
# 🐛 DEBUG (OPTIONAL)
# ======================================
# Enable debug logging
DEBUG=false

# Enable performance monitoring
PERFORMANCE_MONITORING=true
