# ======================================
# ODITO VIDEO SERVICE - PRODUCTION ENVIRONMENT
# ======================================
# 🚨 CRITICAL: All variables are REQUIRED - No fallbacks allowed
# 🚨 CRITICAL: Copy this file to .env and fill in actual values

# ======================================
# 🌐 SERVICE URLs (REQUIRED)
# ======================================
# Backend URLs - Internal and external access
BACKEND_URL=https://api.oditoai.com
BACKEND_INTERNAL_URL=https://api.oditoai.com
BACKEND_PUBLIC_URL=https://api.oditoai.com
MEDIA_BASE_URL=https://api.oditoai.com

# Video Worker Configuration
VIDEO_WORKER_PORT=8001

# Video URL Configuration (for generating correct URLs)
VIDEO_URL=https://video.oditoai.com/videos

# ======================================
# 🗄️ DATABASE (REQUIRED)
# ======================================
# MongoDB connection string (use same as backend)
MONGO_URI=<YOUR_MONGO_URI>

# ======================================
# 📁 FILE STORAGE (REQUIRED)
# ======================================
# Backend Public Path (IMPORTANT: Set this to your actual backend public directory)
# This ensures videos are saved in the correct project folder
BACKEND_PUBLIC_PATH=/path/to/your/backend/public

# ======================================
# 🎙️ VOICE SERVICES (OPTIONAL but RECOMMENDED)
# ======================================
# ElevenLabs API Key for voice generation
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_API_KEY>

# OpenAI API Key for TTS fallback
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# ElevenLabs Voice ID
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ======================================
# 📊 MONITORING (OPTIONAL)
# ======================================
# Log level (debug, info, warning, error)
LOG_LEVEL=info

# ======================================
# 🚀 PERFORMANCE (OPTIONAL)
# ======================================
# Rate limit delay between API calls
RATE_LIMIT_DELAY=2000

# Maximum retry attempts
MAX_RETRIES=3

# Worker timeout
WORKER_TIMEOUT=300000
