# Video Worker Environment Configuration
# Copy this to your .env file and update paths as needed

# Video Worker Configuration
VIDEO_WORKER_PORT=8001
BACKEND_URL=http://localhost:5000

# Backend Public Path (IMPORTANT: Set this to your actual backend public directory)
# This ensures videos are saved in the correct project folder
BACKEND_PUBLIC_PATH=D:/new/Odito/odito_backend/public

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/odito_dev

# Audio Service Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_VOICE_ID=rachel

# Video URL Configuration (for generating correct URLs)
VIDEO_URL=http://localhost:5000/videos
